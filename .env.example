# Local keyless demo. Copy to .env for Docker Compose.
APP_ENV=development
SEED_DEMO=true
AGENT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDINGS_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resolvedesk
# Set a strong password before a non-local deployment.
POSTGRES_PASSWORD=resolvedesk-local-only
