# Local keyless demo. Copy to .env for Docker Compose.
APP_ENV=development
SEED_DEMO=true
AGENT_MODE=demo
LLM_PROVIDER=openai
CLOUD_API_ENABLED=false
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDINGS_ENABLED=false
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resolvedesk
# Set a strong password before a non-local deployment.
POSTGRES_PASSWORD=resolvedesk-local-only
