# Copy to backend/.env for the native Windows launcher. Defaults are keyless.
AGENT_MODE=demo
SEED_DEMO=true
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDINGS_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resolvedesk
# Optional PostgreSQL configuration for a database you already run:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resolvedesk
# CHECKPOINT_URL=postgresql://user:password@localhost:5432/resolvedesk
# Optional private S3 archive (uses standard AWS SDK credentials):
# DOCUMENT_BUCKET=your-private-bucket
# AWS_DEFAULT_REGION=ap-south-1
